---
import CreateEventLayout from "@/layouts/CreateEventLayout.astro";
import CreateNewEventLayout from "@/layouts/CreateNewEventLayout.astro";
import CreateEvent from "@/components/vue/events/create/CreateEvent.vue";
import CreateNewEvent from "@/components/vue/events/create/CreateNewEvent.vue";
import Footer from "@/components/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const user = Astro.locals.user;
const userId = user ? user.id : null;

if (!userId) return Astro.redirect("/signin");
---

<MainLayout title="Crear evento">
  <section>
    <CreateNewEvent client:load userId={userId} />
  </section>
</MainLayout>
