---
import MainLayout from "@/layouts/MainLayout.astro";
import EventDetail from "@/components/vue/events/view/EventDetail.vue";

const id = Astro.params.id ?? "";
const user = Astro.locals.user;

if (!user) return Astro.redirect("/signin");
---

<MainLayout title="Detalle del evento">
  <section>
    <EventDetail client:load id={id} userId={user.id} />
  </section>
</MainLayout>
